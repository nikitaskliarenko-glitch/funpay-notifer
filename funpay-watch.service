[Unit]
Description=FunPay Robux watcher
After=network-online.target
Wants=network-online.target

# Если бот упрётся в потолок памяти и начнёт перезапускаться по кругу,
# systemd сдастся после пяти попыток за пять минут. Бесконечная петля
# перезапусков нагружает сервер сильнее, чем остановленная служба.
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=funpay
WorkingDirectory=/opt/funpay-watch
EnvironmentFile=/opt/funpay-watch/.env
ExecStart=/opt/funpay-watch/.venv/bin/python -m funpay_watch

# Бот — расходный процесс. Если на сервере кончится память, ядро обязано
# выбрать жертвой именно его, а не то, что работает рядом. Значение 1000
# это максимум шкалы и означает «убей меня первым».
OOMScoreAdjust=1000

# Мягкий предел: за ним ядро начинает отбирать у бота память и притормаживать
# его, но не убивает. Замеренный расход около 156 МБ, так что запас есть.
MemoryHigh=200M

# Жёсткий потолок. Выше него бот не вырастет никогда. Если упрётся, погибнет
# он один внутри своей cgroup, соседние процессы этого даже не заметят.
MemoryMax=300M

# Тот же принцип для процессорного времени: бот уступает дорогу всем остальным.
CPUWeight=20
Nice=10

Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
