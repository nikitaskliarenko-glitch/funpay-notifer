[Unit]
Description=FunPay Robux watcher
After=network-online.target
Wants=network-online.target

# Если служба падает сразу после старта, systemd сдаётся после пяти попыток
# за пять минут. Бесконечная петля перезапусков нагружает сервер сильнее,
# чем честно остановленная служба, и прячет настоящую причину в журнале.
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=funpay
WorkingDirectory=/opt/funpay-watch
EnvironmentFile=/opt/funpay-watch/.env
ExecStart=/opt/funpay-watch/.venv/bin/python -m funpay_watch
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
